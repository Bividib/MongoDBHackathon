{
  "name": "@runwayops/policy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run && tsc --noEmit -p tsconfig.typetest.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typetest": "tsc --noEmit -p tsconfig.typetest.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@runwayops/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
