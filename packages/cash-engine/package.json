{
  "name": "@runwayops/cash-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic cash forecast, risk, promise confidence, ranking, and matching helpers for RunwayOps.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@runwayops/domain": "file:../domain"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
